{
  "name": "gitzen",
  "version": "0.8.10-alpha-1",
  "description": "Gitzen - A modern Git GUI application",
  "main": "dist/main.js",
  "scripts": {
    "start": "npm run compile && npm run build:renderer && electron .",
    "dev": "npm run compile && concurrently \"npm run dev:renderer\" \"wait-on http://localhost:5173 && electron .\"",
    "dev:renderer": "vite",
    "build": "npm run compile && npm run build:renderer && electron-builder",
    "build:renderer": "vite build",
    "build:linux": "npm run compile && npm run build:renderer && electron-builder --linux",
    "build:win": "npm run compile && npm run build:renderer && electron-builder --win",
    "compile": "tsc",
    "compile:watch": "tsc --watch",
    "test": "vitest run --dir src",
    "release:alpha": "node scripts/release-alpha.mjs"
  },
  "keywords": [
    "electron",
    "gui"
  ],
  "author": "Henrik <henrik@localhost>",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.19.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^4.0.18",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.gitzen.app",
    "publish": {
      "provider": "github",
      "owner": "0HenrikAndersson0",
      "repo": "gitzen-release"
    },
    "productName": "Gitzen",
    "icon": "icon.png",
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Utility",
      "icon": "icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.png"
    },
    "mac": {
      "icon": "icon.png"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "package.json",
      "preload.js",
      "!**/.env*"
    ],
    "directories": {
      "output": "release"
    }
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.487.0",
    "mermaid": "^11.12.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.2.0",
    "tailwindcss": "^3.4.17"
  }
}
