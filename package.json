{
  "name": "gitzen",
  "version": "1.0.8-beta-1",
  "description": "Gitzen - A modern Git GUI application",
  "main": "dist/main.js",
  "scripts": {
    "start": "npm run compile && npm run build:renderer && electron .",
    "dev": "npm run compile && concurrently \"npm run dev:renderer\" \"wait-on http://localhost:5173 && electron .\"",
    "dev:renderer": "vite",
    "build": "npm run compile && npm run build:renderer && electron-builder",
    "build:renderer": "vite build",
    "build:linux": "npm run compile && npm run build:renderer && electron-builder --linux",
    "build:win": "npm run compile && npm run build:renderer && electron-builder --win",
    "build:mac": "npm run compile && npm run build:renderer && electron-builder --mac dir",
    "compile": "tsc",
    "compile:watch": "tsc --watch",
    "test": "vitest run",
    "release": "node scripts/release.mjs"
  },
  "keywords": [
    "electron",
    "gui"
  ],
  "author": "Henrik <henrik@localhost>",
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/diff": "^7.0.2",
    "@types/node": "^25.9.1",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.1",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.1.2",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.gitzen.app",
    "publish": {
      "provider": "github",
      "owner": "0HenrikAndersson0",
      "repo": "gitzen-release"
    },
    "productName": "Gitzen",
    "icon": "icon.png",
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Utility",
      "icon": "icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.png"
    },
    "mac": {
      "icon": "icon.png"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "package.json",
      "preload.js",
      "!**/.env*"
    ],
    "directories": {
      "output": "release"
    }
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "autoprefixer": "^10.5.0",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "dompurify": "^3.4.11",
    "lodash": "^4.17.24",
    "lodash-es": "^4.17.24",
    "lucide-react": "^0.487.0",
    "mermaid": "^11.15.0",
    "prismjs": "^1.30.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.7",
    "react-is": "^19.2.6",
    "react-window": "^1.8.11",
    "recharts": "^3.8.1",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.0"
  }
}
