{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "compile-typescript",
      "type": "npm",
      "script": "compile",
      "problemMatcher": "$tsc",
      "presentation": {
        "reveal": "silent"
      }
    },
    {
      "label": "start-vite-server",
      "type": "npm",
      "script": "dev:renderer",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": ".",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*",
          "endsPattern": ".*Local:.*http://localhost:5173.*|.*ready in.*"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "start-vite-and-compile",
      "dependsOn": [
        "compile-typescript",
        "start-vite-server"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ]
}

