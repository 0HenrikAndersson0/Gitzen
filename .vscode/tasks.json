{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "compile-typescript",
      "type": "npm",
      "script": "compile",
      "problemMatcher": "$tsc",
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    },
    {
      "label": "start-dev-server",
      "type": "npm",
      "script": "dev:renderer",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": ".*Local:.*http://localhost:5173.*|.*ready in.*ms.*"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "compile-and-start-dev",
      "dependsOn": [
        "compile-typescript",
        "start-dev-server"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "build-renderer",
      "type": "npm",
      "script": "build:renderer",
      "problemMatcher": []
    }
  ]
}

